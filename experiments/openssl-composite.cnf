# EXPERIMENTAL / NOT FOR PRODUCTION
# PQC_COMPOSITE_PROVIDER_MODULE must name the built Composite provider module.
openssl_conf = openssl_init
config_diagnostics = 1

[openssl_init]
providers = provider_sect

[provider_sect]
default = default_sect
composite = composite_sect

[default_sect]
activate = 1

[composite_sect]
module = $ENV::PQC_COMPOSITE_PROVIDER_MODULE
activate = 1
