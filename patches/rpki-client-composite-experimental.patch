+static int
+cert_compliant_composite_key(const char *fn, struct cert *cert)
+{
+	EVP_PKEY *pkey;
+
+	if ((pkey = X509_get0_pubkey(cert->x509)) == NULL) {
+		warnx("%s: cert without public key", fn);
+		return 0;
+	}
+	if (!EVP_PKEY_is_a(pkey, "MLDSA65-ECDSA-P256-SHA512")) {
+		warnx("%s: Composite SPKI did not decode as the expected suite",
+		    fn);
+		return 0;
+	}
+	return 1;
+}
+
