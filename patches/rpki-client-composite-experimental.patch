+			if (ptype != V_ASN1_UNDEF) {
+				warnx("%s: Composite SPKI parameters MUST be absent",
+				    fn);
+				goto out;
+			}
+			if (!cert_compliant_composite_key(fn, cert))
+				goto out;
+			if (verbose)
+				warnx("%s: Composite ML-DSA-65 + ECDSA P-256 "
+				    "support is experimental", fn);
+			break;
+		}
 		/* FALLTHROUGH */
 	case CERT_PURPOSE_BGPSEC_ROUTER:
 		if (OBJ_obj2nid(aobj) == NID_X9_62_id_ecPublicKey) {
