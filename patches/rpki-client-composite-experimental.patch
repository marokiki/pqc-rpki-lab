diff --git a/src/usr.sbin/rpki-client/cert.c b/src/usr.sbin/rpki-client/cert.c
index a807c022..aa236ab8 100644
--- a/src/usr.sbin/rpki-client/cert.c
+++ b/src/usr.sbin/rpki-client/cert.c
@@ -34,6 +34,18 @@ int certid = TALSZ_MAX;
 
 static pthread_rwlock_t	cert_lk = PTHREAD_RWLOCK_INITIALIZER;
 
+#define COMPOSITE_MLDSA65_P256_OID "1.3.6.1.5.5.7.6.45"
+
+static int
+cert_is_composite_mldsa65_p256(const ASN1_OBJECT *obj)
+{
+	char oid[64];
+
+	if (OBJ_obj2txt(oid, sizeof(oid), obj, 1) <= 0)
+		return 0;
+	return strcmp(oid, COMPOSITE_MLDSA65_P256_OID) == 0;
+}
