diff --git a/tests/functional_pqc_rollover.rs b/tests/functional_pqc_rollover.rs
new file mode 100644
index 0000000..0811ca2
--- /dev/null
+++ b/tests/functional_pqc_rollover.rs
@@ -0,0 +1,204 @@
+//! Experimental RSA-parent to Composite-child issuance and rollback test.
+
+use std::{fs, io, path::Path};
+
+use krill::api::roa::RoaConfigurationUpdates;
+use rpki::{crypto::PublicKeyFormat, repository::resources::ResourceSet};
+
+mod common;
+
+#[tokio::test]
+async fn functional_pqc_rollover() {
+    let Some(suite_file) = std::env::var_os("PQC_RPKI_KRILL_SUITE_FILE")
+    else {
+        return;
+    };
+    fs::write(&suite_file, "rsa\n").unwrap();
+
+    let (server, tempdir) =
+        common::KrillServer::start_with_file_storage_and_testbed().await;
+    let parent = common::ca_handle("testbed");
+    let child = common::ca_handle("PQC-CA");
+    let roa_count = std::env::var("PQC_RPKI_KRILL_ROA_COUNT")
+        .ok()
+        .map(|value| value.parse::<u32>().unwrap())
+        .unwrap_or(1);
+    assert!(roa_count > 0);
+    let as_resources = if roa_count == 1 {
+        "AS64496".to_string()
+    } else {
+        format!("AS64496-AS{}", 64495 + roa_count)
+    };
+    let resources =
+        common::resources(&as_resources, "192.0.2.0/24", "2001:db8::/32");
+    let rcn = common::rcn(0);
+
+    assert!(
+        server
+            .wait_for_ca_resources(&parent, &ResourceSet::all())
+            .await
+    );
+    let parent_key = server.ca_key_for_rcn(&parent, &rcn).await;
+    assert_eq!(
+        parent_key
+            .incoming_cert
+            .to_cert()
+            .unwrap()
+            .subject_public_key_info()
+            .algorithm(),
+        PublicKeyFormat::Rsa,
+    );
+
+    fs::write(&suite_file, "composite\n").unwrap();
+    server.create_ca_with_repo(&child).await;
+    server
+        .register_ca_with_parent(&child, &parent, &resources)
+        .await;
+
+    let composite_key = server.ca_key_for_rcn(&child, &rcn).await;
+    assert_eq!(
+        composite_key
+            .incoming_cert
+            .to_cert()
+            .unwrap()
+            .subject_public_key_info()
+            .algorithm(),
+        PublicKeyFormat::MlDsa65EcdsaP256Sha512,
+    );
+
+    let mut roas = vec![common::roa_conf("192.0.2.0/24-24 => 64496")];
+    for offset in 1..roa_count {
+        let prefix = format!(
+            "2001:db8:{:x}:{:x}::/64-64 => {}",
+            offset >> 16,
+            offset & 0xffff,
+            64496 + offset,
+        );
+        roas.push(common::roa_conf(&prefix));
+    }
+    server
+        .client()
+        .roas_update(
+            &child,
+            RoaConfigurationUpdates {
+                added: roas.clone(),
+                removed: vec![],
+            },
+        )
+        .await
+        .unwrap();
+    let mut expected = server.expected_objects(&child);
+    expected.push_mft_and_crl(&rcn).await;
+    expected.push_roas(roas.iter());
+    if roa_count == 1 {
+        assert!(expected.wait_for_published().await);
+    } else {
+        let publisher = child.convert();
+        let mut published = false;
+        for _ in 0..1200 {
+            common::sleep_millis(100).await;
+            let details =
+                server.client().publisher_details(&publisher).await.unwrap();
+            if details.current_files.len() == roa_count as usize + 2 {
+                published = true;
+                break;
+            }
+        }
+        assert!(published);
+    }
+    common::sleep_millis(2000).await;
+    capture_repository(
+        tempdir.path(),
+        &server,
+        [&parent, &child],
+        "composite",
+    )
+    .await;
+    write_tal("composite", &server.client().testbed_tal().await.unwrap());
+
+    fs::write(&suite_file, "rsa\n").unwrap();
+    server.client().ca_init_keyroll(&child).await.unwrap();
+    assert!(server.wait_for_state_new_key(&child).await);
+    let rollback_key = server.ca_new_key_for_rcn(&child, &rcn).await;
+    assert_eq!(
+        rollback_key
+            .incoming_cert
+            .to_cert()
+            .unwrap()
+            .subject_public_key_info()
+            .algorithm(),
+        PublicKeyFormat::Rsa,
+    );
+    server.client().ca_activate_keyroll(&child).await.unwrap();
+    assert!(server.wait_for_state_active(&child).await);
+    capture_repository(
+        tempdir.path(),
+        &server,
+        [&parent, &child],
+        "rollback",
+    )
+    .await;
+    write_tal("rollback", &server.client().testbed_tal().await.unwrap());
+}
+
+fn copy_repository(source: &Path, phase: &str) {
+    let Some(root) = std::env::var_os("PQC_RPKI_KRILL_OUTPUT") else {
+        return;
+    };
+    let target = Path::new(&root).join(phase).join("state");
+    if target.exists() {
+        fs::remove_dir_all(&target).unwrap();
+    }
+    fs::create_dir_all(&target).unwrap();
+    copy_tree(source, &target).unwrap();
+}
+
+async fn capture_repository<'a>(
+    source: &Path,
+    server: &common::KrillServer,
+    cas: impl IntoIterator<Item = &'a rpki::ca::idexchange::CaHandle>,
+    phase: &str,
+) {
+    copy_repository(source, phase);
+    let Some(root) = std::env::var_os("PQC_RPKI_KRILL_OUTPUT") else {
+        return;
+    };
+    let current = Path::new(&root)
+        .join(phase)
+        .join("state/repo/rsync/current");
+    for ca in cas {
+        let publisher = ca.convert();
+        let details =
+            server.client().publisher_details(&publisher).await.unwrap();
+        for file in details.current_files {
+            let uri = file.uri.to_string();
+            let relative =
+                uri.strip_prefix("rsync://localhost/repo/").unwrap();
+            let target = current.join(relative);
+            fs::create_dir_all(target.parent().unwrap()).unwrap();
+            fs::write(target, file.base64.to_bytes()).unwrap();
+        }
+    }
+}
+
+fn write_tal(phase: &str, tal: &str) {
+    let Some(root) = std::env::var_os("PQC_RPKI_KRILL_OUTPUT") else {
+        return;
+    };
+    let target = Path::new(&root).join(phase).join("testbed.tal");
+    fs::write(target, tal).unwrap();
+}
+
+fn copy_tree(source: &Path, target: &Path) -> io::Result<()> {
+    for entry in fs::read_dir(source)? {
+        let entry = entry?;
+        let destination = target.join(entry.file_name());
+        if entry.file_type()?.is_dir() {
+            fs::create_dir_all(&destination)?;
+            copy_tree(&entry.path(), &destination)?;
+        } else {
+            fs::copy(entry.path(), destination)?;
+        }
+    }
+    Ok(())
+}
